{
  // Declaration-only pass for the published package, mirroring packages/sdk.
  // The root tsconfig is `noEmit` and typechecks the workspace against Bun's
  // types; this one exists solely to emit dist/*.d.ts, so it must not assume
  // Bun. `@quirna/sdk` resolves through node_modules to its own published
  // `dist/*.d.ts` — which is what a consumer installing from npm will see —
  // so the `prebuild` script builds the SDK first.
  //
  // `src/bin.ts` is deliberately not included: it is an executable, nobody
  // imports it, and typing its `process` access here would pull @types/node
  // into a package that otherwise needs no ambient types at all.
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/index.ts"]
}
